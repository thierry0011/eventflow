# ---------------------------------------------------------------------------
# EventFlow environment
#
# 12-factor rule: config lives in the environment, never in code, never in git.
# Copy to .env and edit. .env is gitignored; .env.example is committed so a new
# engineer knows exactly which knobs exist.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=json          # json in prod, console when you are reading logs by eye

# --- Postgres -------------------------------------------------------------
# One logical database per service. Shared instance locally, separate instances
# in production. NEVER let two services read each other's tables.
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=eventflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

ORDERS_DB=orders_db
INVENTORY_DB=inventory_db
NOTIFICATIONS_DB=notifications_db

# --- Redis ----------------------------------------------------------------
# db 0 = cache, db 1 = celery broker, db 2 = celery results, db 3 = locks/limits
REDIS_URL=redis://redis:6379

# --- Kafka ----------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_ORDERS=orders.events
KAFKA_TOPIC_INVENTORY=inventory.events

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=eventflow.notifications

# --- Security -------------------------------------------------------------
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-not-a-real-secret-change-me
JWT_SECRET=dev-only-shared-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900

# --- Service tuning -------------------------------------------------------
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_BATCH_SIZE=100
CONSUMER_MAX_RETRIES=5
RESERVATION_TTL_SECONDS=900
CACHE_TTL_SECONDS=60
RATE_LIMIT_PER_MINUTE=120
